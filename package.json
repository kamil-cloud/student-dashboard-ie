{
  "name": "student-dashboard-web",
  "version": "1.0.0",
  "description": "For IE University students: every Blackboard deadline, class and grade in one list, with reminders. Accounts and data in Supabase.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/build.mjs --test-hosts && node tests/e2e/saas.mjs && node tests/e2e/run.mjs && node tests/e2e/bookmark.mjs",
    "package": "node scripts/build.mjs --zip",
    "e2e:bot": "node scripts/build.mjs --test-hosts && node tests/e2e/saas.mjs",
    "test:db": "node tests/db/rls.mjs",
    "live-check": "node tests/e2e/saas.mjs --live"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "immer": "^11.1.18",
    "lucide-react": "^1.48.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3"
  }
}
